# Copy to .env.local for development. Set the same keys in Vercel → Project → Settings → Environment Variables.

# Public site URL (OAuth redirect_uri must match Google Cloud Console)
NEXT_PUBLIC_SITE_URL=https://leinen-los.vercel.app

# Supabase (required for auth, sync, analytics)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin dashboard (/admin) — GET /api/analytics
ADMIN_PASSWORD=

# Google OAuth (optional — email/password works without these)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Data pipeline scripts only (not needed on Vercel)
OPENROUTER_API_KEY=
